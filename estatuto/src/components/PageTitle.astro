---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';

const isStatute = Astro.url.pathname === '/';
---

<DefaultPageTitle />
{isStatute && (
  <div class="document-actions">
    <button type="button" id="print-document" hidden>Imprimir documento</button>
    <a class="document-actions__download" href="/estatuto-regimento-interno-assinado.pdf" download>
      Baixar versão assinada em PDF
    </a>
  </div>
)}

<script>
  const printButton = document.querySelector<HTMLButtonElement>('#print-document');

  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', async () => {
      await document.fonts.ready;
      window.print();
    });
  }
</script>
