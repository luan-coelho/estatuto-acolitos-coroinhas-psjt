{
  "name": "estatuto-acolitos-coroinhas-psjt",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "docs:sync": "bun scripts/docs-sync.mjs",
    "test": "bun test scripts/docs-sync.test.mjs",
    "check": "bun run docs:sync && astro check",
    "build": "bun run test && bun run check && astro build",
    "dev": "bun run docs:sync && astro dev",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "docs": "bun run build && bun run preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.131.2"
  }
}

